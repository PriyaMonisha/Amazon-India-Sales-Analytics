# Data — raw source files are large; never commit
/data/raw/
/data/processed/
/data/feast_registry.db

# Model artifacts (binaries) — bake into Docker image, not git
/artifacts/models/*.pkl
/artifacts/models/*.json
/artifacts/drift/
/artifacts/charts/

# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.ruff_cache/

# MLflow run artifacts (large; stored in MinIO)
mlruns/

# Notebooks — .py source is committed, not .ipynb outputs
notebooks/*.ipynb

# Feast registry (auto-generated by feast apply)
feast_repo/__pycache__/

# Environment
.env

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# AI assistant config (internal development tooling — not for repo)
.claude/
CLAUDE.md
