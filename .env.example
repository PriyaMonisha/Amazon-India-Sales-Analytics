# Environment — local | docker | airflow
APP_ENV=local

# Fast mode — true for dev (50K sample, 10 Optuna trials), false for full pipeline
FAST_MODE=true

# PostgreSQL
POSTGRES_DB=amazon_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by src/ modules for all environments (set real password here, never in config.py)
AMAZON_DB_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/amazon_sales

# API Security — required for all /predict/* endpoints
# Generate with: openssl rand -hex 32
# PowerShell: -join ((1..32)|%{'{0:x2}' -f (Get-Random -Max 256)})
API_KEY=replace-with-32-char-random-string

# Redis
REDIS_PORT=6379

# MinIO (local S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# FastAPI
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# Model thresholds (optional overrides)
CHURN_THRESHOLD=0.5

# Airflow (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_UID=50000

# Pandera — suppress FutureWarning for top-level import (use pandera.pandas)
DISABLE_PANDERA_IMPORT_WARNING=True
