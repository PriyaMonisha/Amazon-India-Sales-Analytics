# Environment — local | docker | airflow
APP_ENV=local

# Fast mode — true for dev (50K sample, 10 Optuna trials), false for full pipeline
FAST_MODE=true

# PostgreSQL
POSTGRES_DB=amazon_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Used by src/ modules when APP_ENV=airflow (NOT AIRFLOW_CONN_* — different purpose)
AMAZON_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/amazon_sales

# Redis
REDIS_PORT=6379

# MinIO (local S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# FastAPI
FASTAPI_HOST=localhost
FASTAPI_PORT=8000

# Model thresholds (optional overrides)
CHURN_THRESHOLD=0.5

# Airflow (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_UID=50000
